// Copy to Secrets.xcconfig (gitignored) and fill in the values from web-app/.env.local.
// xcconfig treats "//" as a comment, so give the host only (no https://).
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_...
// DEBUG builds only: the demo password (DEMO_PASSWORD in ../.env.local) for persona switching. Leave empty to turn it off.
DEMO_PASSWORD =
